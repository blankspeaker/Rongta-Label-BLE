<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Rongta-Label-BLE</title>
    <welcome file="welcome.rtf" mime-type="text/rtf"/>
    <background file="background.png" alignment="bottomright" scaling="proportional"/>
    <license file="license.txt" mime-type="text/plain"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="driver"/>
    </choices-outline>
    <choice id="driver" title="Rongta Label Printer" description="Print to a Rongta label printer over Bluetooth LE.">
        <pkg-ref id="com.blankspeaker.rongta-label"/>
    </choice>
    <pkg-ref id="com.blankspeaker.rongta-label" version="1.0.0" onConclusion="none">rongta-label-component.pkg</pkg-ref>
</installer-gui-script>
